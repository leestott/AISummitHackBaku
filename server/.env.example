# Copy this file to .env only for a fresh checkout; keep an existing .env.
# Set the endpoint to the actual Foundry project endpoint before using the AI features.
FOUNDRY_PROJECT_ENDPOINT=
CASPIAN_FOUNDRY_AGENT_NAME=caspian-compass
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4-mini

# Leave blank for the deployed hosted agent. For an explicitly started local
# hosted runtime only, use its loopback Responses endpoint (for example :8088/v1).
CASPIAN_FOUNDRY_LOCAL_ENDPOINT=
